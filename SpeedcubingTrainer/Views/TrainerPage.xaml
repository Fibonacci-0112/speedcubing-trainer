<Page x:Class="SpeedcubingTrainer.Views.TrainerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:SpeedcubingTrainer.Views"
      xmlns:vm="using:SpeedcubingTrainer.ViewModels"
      xmlns:controls="using:SpeedcubingTrainer.Controls"
      Background="{ThemeResource BackgroundBrush}">
  <ScrollViewer>
    <Grid Padding="16" RowSpacing="12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Mode and pool -->
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ComboBox ItemsSource="{x:Bind ViewModel.Modes}" SelectedItem="{x:Bind ViewModel.SelectedMode, Mode=TwoWay}" MinWidth="160" />
          <ComboBox ItemsSource="{x:Bind ViewModel.PoolFilters}" SelectedItem="{x:Bind ViewModel.SelectedPool, Mode=TwoWay}" MinWidth="190" />
          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
            <CheckBox Content="F2L" IsChecked="{x:Bind ViewModel.IncludeF2L, Mode=TwoWay}" MinWidth="0" />
            <CheckBox Content="OLL" IsChecked="{x:Bind ViewModel.IncludeOll, Mode=TwoWay}" MinWidth="0" />
            <CheckBox Content="PLL" IsChecked="{x:Bind ViewModel.IncludePll, Mode=TwoWay}" MinWidth="0" />
          </StackPanel>
        </StackPanel>
        <TextBlock Text="{x:Bind ViewModel.PoolText, Mode=OneWay}" Opacity="0.7" TextWrapping="Wrap" />
      </StackPanel>

      <!-- Case display -->
      <Grid x:Name="CaseSurface" Grid.Row="1" Background="Transparent" PointerPressed="OnSurfacePressed" MinHeight="260">
        <StackPanel HorizontalAlignment="Center" Spacing="10">
          <controls:CaseView Case="{x:Bind ViewModel.CurrentCase, Mode=OneWay}" State="{x:Bind ViewModel.CurrentState, Mode=OneWay}" Size="220"
                             ShowArrows="{x:Bind ViewModel.IsAnswerVisible, Mode=OneWay}"
                             Visibility="{x:Bind local:TrainerPage.Show(ViewModel.HasCase), Mode=OneWay}" />
          <TextBlock Text="{x:Bind ViewModel.DrillTimeText, Mode=OneWay}" FontSize="48" FontWeight="Light" TextAlignment="Center"
                     Visibility="{x:Bind local:TrainerPage.Show(ViewModel.IsDrill), Mode=OneWay}" />
          <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="520" />
          <TextBlock Text="{x:Bind ViewModel.AnswerText, Mode=OneWay}" FontSize="22" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="600" IsTextSelectionEnabled="True"
                     Visibility="{x:Bind local:TrainerPage.Show(ViewModel.IsAnswerVisible), Mode=OneWay}" />
          <TextBlock Opacity="0.6" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="600"
                     Visibility="{x:Bind local:TrainerPage.Show(ViewModel.HasCase), Mode=OneWay}">
            <Run Text="Setup on a solved cube: " /><Run Text="{x:Bind ViewModel.SetupText, Mode=OneWay}" />
          </TextBlock>
        </StackPanel>
      </Grid>

      <!-- Drill controls -->
      <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                  Visibility="{x:Bind local:TrainerPage.Show(ViewModel.IsDrill), Mode=OneWay}">
        <Button Content="Start / Next (space)" Command="{x:Bind ViewModel.StartDrillCommand}" Style="{StaticResource FilledButtonStyle}" IsTabStop="False" />
        <Button Content="Failed" Command="{x:Bind ViewModel.FailDrillCommand}" IsTabStop="False" />
      </StackPanel>

      <!-- Memorize controls -->
      <StackPanel Grid.Row="2" Spacing="8" HorizontalAlignment="Center"
                  Visibility="{x:Bind local:TrainerPage.Show(ViewModel.IsMemorize), Mode=OneWay}">
        <TextBlock Text="{x:Bind ViewModel.QueueText, Mode=OneWay}" TextAlignment="Center" Opacity="0.7" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
          <Button Content="Start review" Command="{x:Bind ViewModel.StartMemorizeCommand}" Style="{StaticResource FilledButtonStyle}" IsTabStop="False"
                  Visibility="{x:Bind local:TrainerPage.Collapse(ViewModel.HasCase), Mode=OneWay}" />
          <Button Content="Show answer (space)" Command="{x:Bind ViewModel.RevealAnswerCommand}" IsTabStop="False"
                  Visibility="{x:Bind local:TrainerPage.ShowIf(ViewModel.HasCase, ViewModel.IsAnswerVisible), Mode=OneWay}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                    Visibility="{x:Bind local:TrainerPage.ShowIf(ViewModel.IsAnswerVisible, ViewModel.IsQuiz), Mode=OneWay}">
          <Button Content="{x:Bind ViewModel.AgainText, Mode=OneWay}" Command="{x:Bind ViewModel.GradeCommand}" CommandParameter="Again" MinWidth="90" IsTabStop="False" />
          <Button Content="{x:Bind ViewModel.HardText, Mode=OneWay}" Command="{x:Bind ViewModel.GradeCommand}" CommandParameter="Hard" MinWidth="90" IsTabStop="False" />
          <Button Content="{x:Bind ViewModel.GoodText, Mode=OneWay}" Command="{x:Bind ViewModel.GradeCommand}" CommandParameter="Good" MinWidth="90" IsTabStop="False" />
          <Button Content="{x:Bind ViewModel.EasyText, Mode=OneWay}" Command="{x:Bind ViewModel.GradeCommand}" CommandParameter="Easy" MinWidth="90" IsTabStop="False" />
        </StackPanel>
      </StackPanel>

      <!-- Quiz controls -->
      <StackPanel Grid.Row="2" Spacing="8" HorizontalAlignment="Center"
                  Visibility="{x:Bind local:TrainerPage.Show(ViewModel.IsQuiz), Mode=OneWay}">
        <ItemsControl ItemsSource="{x:Bind ViewModel.Choices}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:QuizChoice">
              <Button Content="{x:Bind Text}" MinWidth="320" HorizontalAlignment="Stretch" Click="OnChoiceClick" IsTabStop="False" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{x:Bind ViewModel.QuizFeedback, Mode=OneWay}" TextAlignment="Center" FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
          <Button Content="Next question (space)" Command="{x:Bind ViewModel.StartQuizCommand}" Style="{StaticResource FilledButtonStyle}" IsTabStop="False" />
          <TextBlock Text="{x:Bind ViewModel.ScoreText, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.7" />
        </StackPanel>
      </StackPanel>

      <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.DrillHint, Mode=OneWay}" Opacity="0.5" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                 Visibility="{x:Bind local:TrainerPage.Show(ViewModel.IsDrill), Mode=OneWay}" />
    </Grid>
  </ScrollViewer>
</Page>
