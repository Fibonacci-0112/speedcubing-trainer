<Page x:Class="SpeedcubingTrainer.Views.SessionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:SpeedcubingTrainer.Views"
      xmlns:vm="using:SpeedcubingTrainer.ViewModels"
      xmlns:core="using:SpeedcubingTrainer.Core.Persistence"
      xmlns:controls="using:SpeedcubingTrainer.Controls"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource BackgroundBrush}">
  <Grid Padding="16" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Session picker and actions -->
    <StackPanel Grid.Row="0" Spacing="8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ComboBox ItemsSource="{x:Bind ViewModel.Sessions}" SelectedItem="{x:Bind ViewModel.SelectedSession, Mode=TwoWay}" MinWidth="200"
                  DisplayMemberPath="Name" />
        <Button Content="New" Click="OnNewSession" />
        <Button Content="Rename" Click="OnRenameSession" />
        <Button Content="Delete" Click="OnDeleteSession" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Export JSON" Click="OnExportJson" />
        <Button Content="Export CSV" Click="OnExportCsv" />
        <Button Content="Import JSON" Click="OnImportJson" />
        <Button Content="Clear solves" Click="OnClearSolves" />
        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.7" />
      </StackPanel>
    </StackPanel>

    <!-- Summary -->
    <StackPanel Grid.Row="1" Spacing="8">
      <TextBlock Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" Opacity="0.8" />
      <ItemsControl ItemsSource="{x:Bind ViewModel.Cards, Mode=OneWay}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <utu:AutoLayout Orientation="Horizontal" Spacing="12" Justify="Stack" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:StatCard">
            <Border Padding="12,8" CornerRadius="8" Background="{ThemeResource SurfaceVariantBrush}" MinWidth="90">
              <StackPanel>
                <TextBlock Text="{x:Bind Label}" Opacity="0.6" FontSize="11" />
                <TextBlock Text="{x:Bind Current}" FontSize="18" />
                <TextBlock Text="{x:Bind Best}" Opacity="0.7" FontSize="12" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- Charts and list -->
    <Grid Grid.Row="2" ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="240" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid Grid.Column="0" RowSpacing="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:TrendChartView Grid.Row="0" Solves="{x:Bind ViewModel.Times, Mode=OneWay}" />
        <controls:HistogramView Grid.Row="1" Solves="{x:Bind ViewModel.Times, Mode=OneWay}" Height="130" />
      </Grid>
      <ListView Grid.Column="1" Width="360" ItemsSource="{x:Bind ViewModel.Solves}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnSolveClick">
        <ListView.Header>
          <Grid Padding="8,4" ColumnSpacing="8" Opacity="0.6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="36" />
              <ColumnDefinition Width="80" />
              <ColumnDefinition Width="70" />
              <ColumnDefinition Width="70" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="#" FontSize="11" />
            <TextBlock Grid.Column="1" Text="time" FontSize="11" />
            <TextBlock Grid.Column="2" Text="ao5" FontSize="11" />
            <TextBlock Grid.Column="3" Text="ao12" FontSize="11" />
            <TextBlock Grid.Column="4" Text="date" FontSize="11" />
          </Grid>
        </ListView.Header>
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="vm:SolveRow">
            <Grid ColumnSpacing="8" Padding="0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{x:Bind Number}" Opacity="0.6" />
              <TextBlock Grid.Column="1" Text="{x:Bind Time}" FontWeight="SemiBold" />
              <TextBlock Grid.Column="2" Text="{x:Bind Ao5}" Opacity="0.8" />
              <TextBlock Grid.Column="3" Text="{x:Bind Ao12}" Opacity="0.8" />
              <TextBlock Grid.Column="4" Text="{x:Bind Date}" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis" />
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Grid>
  </Grid>
</Page>
