<Page x:Class="SpeedcubingTrainer.Shell"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource BackgroundBrush}">
  <muxc:NavigationView x:Name="Nav"
                       utu:SafeArea.Insets="VisibleBounds"
                       PaneDisplayMode="Auto"
                       IsSettingsVisible="True"
                       IsBackButtonVisible="Collapsed"
                       SelectionChanged="OnSelectionChanged">
    <muxc:NavigationView.MenuItems>
      <muxc:NavigationViewItem Content="Timer" Tag="timer" Icon="Clock" />
      <muxc:NavigationViewItem Content="Sessions" Tag="sessions" Icon="List" />
      <muxc:NavigationViewItem Content="Algorithms" Tag="algorithms" Icon="Library" />
      <muxc:NavigationViewItem Content="Trainer" Tag="trainer" Icon="Target" />
    </muxc:NavigationView.MenuItems>
    <Frame x:Name="ContentFrame" />
  </muxc:NavigationView>
</Page>
